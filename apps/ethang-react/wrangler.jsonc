{
  "$schema": "node_modules/wrangler/config-schema.json",
  "assets": {
    "not_found_handling": "single-page-application"
  },
  "cache": {
    "enabled": true
  },
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "exports": {
    "default": {
      "cache": {
        "enabled": true
      },
      "type": "worker"
    }
  },
  "main": "worker/index.ts",
  "name": "ethang-react",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "placement": {
    "mode": "smart"
  },
  "routes": [
    {
      "custom_domain": true,
      "pattern": "ethang.dev"
    },
    {
      "custom_domain": true,
      "pattern": "www.ethang.dev"
    }
  ],
  "services": [
    {
      "binding": "ethang_courses",
      "remote": true,
      "service": "ethang-courses"
    },
    {
      "binding": "ethang_rss",
      "remote": true,
      "service": "ethang-rss"
    }
  ],
  "upload_source_maps": true
}
