{
  "browserslist": [
    "extends browserslist-config-baseline",
    "current node"
  ],
  "dependencies": {
    "@portabletext/to-html": "^6.0.0",
    "@sanity/client": "^8.6.2",
    "@sanity/image-url": "^2.1.1",
    "@tailwindcss/cli": "^4.3.3",
    "calendar-link": "^2.11.5",
    "effect": "^3.22.2",
    "esbuild": "^0.28.2",
    "hono": "^4.13.8",
    "lodash": "^4.18.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@ethang/eslint-config": "workspace:*",
    "@faker-js/faker": "^10.6.0",
    "@portabletext/types": "^4.0.2",
    "@tailwindcss/typography": "^0.5.20",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/lodash": "^4.17.25",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^4.1.11",
    "browserslist-config-baseline": "^0.5.0",
    "eslint": "^10.11.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.136.0"
  },
  "engines": {
    "node": ">=24"
  },
  "name": "sterett-hono",
  "scripts": {
    "build:sw": "tsx build.ts",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "deploy": "pnpm run cf-typegen && pnpm run tw && wrangler deploy --minify",
    "dev": "wrangler dev",
    "lint": "eslint . --fix && pnpm tsc --noEmit",
    "test": "vitest run --coverage",
    "tw": "pnpx @tailwindcss/cli -i ./src/style.css -o ./public/index.css",
    "tw:watch": "pnpx @tailwindcss/cli -i ./src/style.css -o ./public/index.css --watch"
  },
  "type": "module",
  "version": "1.0.0"
}
