---
import filter from "lodash/filter.js";
import find from "lodash/find.js";
import includes from "lodash/includes.js";
import isNil from "lodash/isNil.js";
import isString from "lodash/isString.js";
import map from "lodash/map.js";

export type MarkDef = {
  _key?: string;
  _type?: string;
  href?: string;
};

export type PortableSpan = {
  _type?: string;
  marks?: string[];
  text?: string;
};

interface Props {
  children?: PortableSpan[];
  markDefs?: MarkDef[];
}

const { children = [], markDefs = [] } = Astro.props;

const DECORATORS = ["strong", "em", "code", "underline", "strike-through"];

const spans = map(children, (span) => {
  const marks = span.marks ?? [];

  const annotationKey = find(marks, (mark) => {
    return !includes(DECORATORS, mark);
  });

  const annotation = isNil(annotationKey)
    ? null
    : (find(markDefs, (definition) => {
        return definition._key === annotationKey;
      }) ?? null);

  const href = isNil(annotation)
    ? null
    : isString(annotation.href)
      ? annotation.href
      : null;

  return {
    decorators: filter(marks, (mark) => {
      return includes(DECORATORS, mark);
    }),
    href,
    text: isString(span.text) ? span.text : ""
  };
});

const isExternal = (href: string) => {
  return !href.startsWith("/") && !href.startsWith("#");
};
---

{
  map(spans, (span) => {
    const hasCode = includes(span.decorators, "code");
    const hasStrong = includes(span.decorators, "strong");
    const hasEm = includes(span.decorators, "em");
    const hasUnderline = includes(span.decorators, "underline");
    const hasStrike = includes(span.decorators, "strike-through");

    // Innermost: the raw text, optionally wrapped in <code>
    const textNode = hasCode ? (
      <code class="rounded bg-night-owl-bg px-1 py-0.5 font-mono text-sm text-night-owl-green">
        {span.text}
      </code>
    ) : (
      span.text
    );

    // Apply decorators from inside out
    const strikeNode = hasStrike ? <s>{textNode}</s> : textNode;
    const underlineNode = hasUnderline ? <u>{strikeNode}</u> : strikeNode;
    const emNode = hasEm ? <em>{underlineNode}</em> : underlineNode;
    const strongNode = hasStrong ? <strong>{emNode}</strong> : emNode;

    if (isNil(span.href)) {
      return strongNode;
    }

    return isExternal(span.href) ? (
      <a
        href={span.href}
        target="_blank"
        rel="noopener noreferrer"
        class="text-primary hover:underline"
      >
        {strongNode}
      </a>
    ) : (
      <a href={span.href} class="text-primary hover:underline">
        {strongNode}
      </a>
    );
  })
}
