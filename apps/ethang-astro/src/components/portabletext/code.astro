---
import type { Props } from "astro-portabletext";

const props = Astro.props as Props & { node?: Record<string, unknown> };
// eslint-disable-next-line @typescript-eslint/no-unsafe-member-access
const node = (props.node ?? {}) as { code?: string; language?: string };

const hasCode = typeof node.code === "string" && node.code.length > 0;
---

{hasCode ? (
  <pre class="bg-night-owl-surface rounded-lg p-4 my-3 overflow-x-auto">
    <code class="text-sm font-mono text-night-owl-green">{node.code}</code>
  </pre>
) : null}
