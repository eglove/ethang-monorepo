---
import { Image } from "astro:assets";
import type { Props } from "astro-portabletext";

import { IMAGE_MAX_WIDTH, resolveImageDimensions } from "../../lib/image.ts";

const sanityImage = (await import("../../lib/sanity.ts")).sanityImage;

const props = Astro.props as Props & { node?: Record<string, unknown> };
const node = (props.node ?? {}) as {
  alt?: string;
  asset?: {
    caption?: string;
    metadata?: {
      dimensions?: {
        aspectRatio?: number;
        height?: number;
        width?: number;
      };
      url?: string;
    };
  };
};
const assetUrl = node.asset?.url as string | undefined;

const hasAsset = typeof assetUrl === "string" && assetUrl.length > 0;
const { height, width } = hasAsset
  ? resolveImageDimensions(node.asset?.metadata?.dimensions)
  : { height: 0, width: 0 };
---

{
  hasAsset ? (
    <figure class="my-4">
      <Image
        src={sanityImage.image(assetUrl).width(IMAGE_MAX_WIDTH).fit("max").auto("format").url()}
        alt={node.alt ?? ""}
        width={width}
        height={height}
        loading="lazy"
        class="w-full rounded-lg object-cover"
      />
      {typeof node.asset?.caption === "string" && node.asset.caption.length > 0 ? (
        <figcaption class="text-xs text-night-owl-muted text-center mt-1">{node.asset.caption}</figcaption>
      ) : null}
    </figure>
  ) : null
}
