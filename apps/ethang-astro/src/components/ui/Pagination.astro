---
import map from "lodash/map.js";

import { paginationEdgeClass, paginationNumberClass } from "../../lib/ui.ts";

export type PaginationEntry = {
    readonly href: string;
    readonly label: string;
};

interface Props {
    ariaLabel: string;
    currentIndex: number;
    entries: readonly PaginationEntry[];
}

const { ariaLabel, currentIndex, entries } = Astro.props;
---

{
    1 < entries.length ? (
        <nav class="flex gap-2 justify-center" aria-label={ariaLabel}>
            {
                0 < currentIndex ? (
                    <a
                        href={entries[currentIndex - 1]?.href}
                        rel="prev"
                        aria-label="Previous page"
                        class={paginationEdgeClass(false)}
                    >
                        &lsaquo;
                    </a>
                ) : (
                    <span aria-hidden="true" class={paginationEdgeClass(true)}>
                        &lsaquo;
                    </span>
                )
            }

            {
                map(entries, (entry, index) => (
                    <a
                        href={entry.href}
                        aria-current={
                            index === currentIndex ? "page" : undefined
                        }
                        class={paginationNumberClass(index === currentIndex)}
                    >
                        {entry.label}
                    </a>
                ))
            }

            {
                currentIndex < entries.length - 1 ? (
                    <a
                        href={entries[currentIndex + 1]?.href}
                        rel="next"
                        aria-label="Next page"
                        class={paginationEdgeClass(false)}
                    >
                        &rsaquo;
                    </a>
                ) : (
                    <span aria-hidden="true" class={paginationEdgeClass(true)}>
                        &rsaquo;
                    </span>
                )
            }
        </nav>
    ) : null
}
