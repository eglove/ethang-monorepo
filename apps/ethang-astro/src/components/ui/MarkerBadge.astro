---
import { markerBadgeClass, type LearnMarker } from "../../lib/learn.ts";

interface Props {
  class?: string;
  /* How many of this format, shown beside the icon when the badge is a tally. */
  count?: number;
  marker: LearnMarker;
  size?: number;
}

const { class: className = "", count, marker, size = 14 } = Astro.props;

/*
 * Lucide geometry, inlined as paths. Importing lucide-astro into a component
 * breaks this app's Cloudflare prerender chunking, and six static icons do not
 * justify a client dependency: the markup is a 24x24 stroke icon either way.
 * Paths from lucide 0.556.0.
 */
const PATHS: Readonly<Record<LearnMarker, readonly string[]>> = {
  book: ["M12 7v14", "M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"],
  corpus: ["m16 6 4 14", "M12 6v14", "M8 8v12", "M4 4v16"],
  course: ["M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z", "M22 10v6", "M6 12.5V16a6 3 0 0 0 12 0v-3.5"],
  lab: ["M14 2v6a2 2 0 0 0 .245.96l5.51 10.08A2 2 0 0 1 18 22H6a2 2 0 0 1-1.755-2.96l5.51-10.08A2 2 0 0 0 10 8V2", "M6.453 15h11.094", "M8.5 2h7"],
  paper: ["M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z", "M14 2v5a1 1 0 0 0 1 1h5", "M10 9H8", "M16 13H8", "M16 17H8"],
  video: ["M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z"]
};

/*
 * The icon is the badge. The format name is carried as an aria-label on a
 * role="img" wrapper, so a screen reader announces "video" while the sighted
 * reader gets the glyph and no visible label competes with it.
 */
const label = undefined === count ? marker : `${count} ${marker}`;
const paths = PATHS[marker];
---

<span
  role="img"
  aria-label={label}
  class={`inline-flex shrink-0 items-center gap-1 rounded-md border px-1.5 py-1 ${markerBadgeClass(marker)} ${className}`}
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    class="shrink-0"
  >
    {paths.map((d) => <path d={d} />)}
  </svg>
  {undefined === count ? null : <span class="font-mono text-xs">{count}</span>}
</span>