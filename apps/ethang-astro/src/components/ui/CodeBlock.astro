---
import { Code } from "astro/components";

import { sanitizeCodeLanguage } from "../../lib/ui.ts";

interface Props {
    code: string;
    lang?: string;
}

const { code, lang } = Astro.props;
---

<Code
    code={code}
    lang={sanitizeCodeLanguage(lang)}
    theme="night-owl"
    class="rounded-lg p-4 overflow-x-auto text-sm font-mono border"
/>
