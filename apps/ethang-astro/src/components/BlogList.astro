---
import { DateTime } from "effect";
import isNil from "lodash/isNil.js";
import isEmpty from "lodash/isEmpty.js";
import map from "lodash/map.js";

import { toPageHref, type BlogListPost } from "../lib/blog.ts";
import Card from "./ui/Card.astro";
import Heading from "./ui/Heading.astro";
import InlineLink from "./ui/InlineLink.astro";
import Pagination from "./ui/Pagination.astro";

interface Props {
  maxPages: number;
  page: number;
  posts: BlogListPost[];
}

const { maxPages, page, posts } = Astro.props;

const formattedDate = (date?: DateTime.Utc) => {
  if (isNil(date)) {
    return "";
  }

  return DateTime.format(date, {
    dateStyle: "medium",
    timeStyle: "short"
  });
};
---

<div class="my-8 grid w-full gap-4">
  {
    isEmpty(posts) ? (
      <Card class="flex justify-center p-8">
        <span class="text-night-owl-muted">No blog posts found.</span>
      </Card>
    ) : (
      map(posts, (blog) => (
        <article
          class="surface-card border border-night-owl-border bg-night-owl-surface p-5 transition-colors hover:border-primary/60 hover:bg-night-owl-surface/90 sm:p-6"
          data-blog-post=""
        >
          {blog.data.blogCategory ? (
            <p class="section-kicker mb-3">
              {blog.data.blogCategory}
            </p>
          ) : null}
          <Heading as="h2" class="text-xl mb-1">
            <InlineLink variant="underline" href={`/blog/${blog.data.slug}`}>
              {blog.data.title}
            </InlineLink>
          </Heading>
          {blog.data.updatedDate ? (
            <p class="mt-3 font-mono text-xs text-night-owl-muted">
              <span class="text-night-owl-cyan">Updated</span> / {formattedDate(blog.data.updatedDate)}
            </p>
          ) : null}
        </article>
      ))
    )
  }
</div>

<Pagination linkFor={toPageHref} maxPages={maxPages} page={page} />