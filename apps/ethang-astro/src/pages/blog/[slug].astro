---
import isNil from "lodash/isNil.js";
import map from "lodash/map.js";

import SanityText from "../../components/SanityText.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { fetchBlogPost, fetchBlogSlugs } from "../../lib/blog.ts";

export const prerender = true;

export const getStaticPaths = async () => {
  const slugs = await fetchBlogSlugs();

  return map(slugs, (slug) => {
    return { params: { slug } };
  });
};

const { slug } = Astro.params;

const post = isNil(slug) ? null : await fetchBlogPost(slug);
---

<BaseLayout title={post?.title ?? "Blog Post"}>
  <div class="max-w-7xl mx-auto px-4 py-6">
    <h1 class="text-4xl font-semibold text-night-owl-fg mb-6">
      {post?.title ?? "Blog Post"}
    </h1>
    {
      isNil(post?.body) ? (
        <p class="text-night-owl-muted">No content available.</p>
      ) : (
        <SanityText value={post.body} />
      )
    }
  </div>
</BaseLayout>
