---
import BlogList from "../../components/BlogList.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { fetchBlogPage } from "../../lib/blog.ts";

export const prerender = true;

const { maxPages, posts } = await fetchBlogPage(1);
---

<BaseLayout title="Blog">
  <div class="flex flex-col items-center gap-2 max-w-7xl mx-auto px-4 py-6">
    <h1 class="text-4xl font-semibold text-night-owl-fg">Blog</h1>
    <BlogList maxPages={maxPages} page={1} posts={posts} />
  </div>
</BaseLayout>
