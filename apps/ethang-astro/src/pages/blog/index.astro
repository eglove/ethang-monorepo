---
import BlogList from "../../components/BlogList.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Heading from "../../components/ui/Heading.astro";
import Page from "../../components/ui/Page.astro";
import { fetchBlogPage } from "../../lib/blog.ts";

export const prerender = true;

const { maxPages, posts } = await fetchBlogPage(1);
---

<BaseLayout title="Blog">
  <Page class="flex flex-col items-center gap-2">
    <Heading as="h1" class="text-4xl">Blog</Heading>
    <BlogList maxPages={maxPages} page={1} posts={posts} />
  </Page>
</BaseLayout>
