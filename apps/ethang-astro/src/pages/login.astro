---
import BaseLayout from "../layouts/BaseLayout.astro";
import { actions } from "astro:actions";
import { forms } from "../../constants/forms.ts";

const result = Astro.getActionResult(actions.signIn);
// Middleware handles redirect on success, so we only show errors here
const error = result?.error ?? Astro.url.searchParams.get("error");
---

<BaseLayout title="Login">
  <div class="flex items-center justify-center min-h-form-viewport p-4 max-w-7xl mx-auto">
    <div class="w-full max-w-md rounded-2xl border border-night-owl-border bg-night-owl-surface/50 p-8 shadow-xl backdrop-blur-lg">
      <form method="POST" action={actions.signIn}>
        <div class="flex flex-col gap-4">
          <h1 class="text-xl font-semibold tracking-tight text-center text-night-owl-fg mb-2">{forms.SIGN_IN_TO_ACCOUNT}</h1>

          {error ? (
            <div class="rounded-xl border border-danger/60 bg-danger/10 p-3">
              <p class="text-sm font-medium text-center text-danger">{error}</p>
            </div>
          ) : null}

          <div class="flex flex-col gap-1">
            <label for="email" class="text-xs font-bold text-night-owl-muted uppercase">{forms.EMAIL_ADDRESS}</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder={forms.ENTER_YOUR_EMAIL}
              class="rounded-lg border border-night-owl-border bg-night-owl-bg/80 px-3 py-2 text-night-owl-fg focus:border-primary transition-colors outline-none"
            />
          </div>

          <div class="flex flex-col gap-1">
            <label for="password" class="text-xs font-bold text-night-owl-muted uppercase">{forms.PASSWORD}</label>
            <input
              type="password"
              id="password"
              name="password"
              required
              placeholder={forms.ENTER_YOUR_PASSWORD}
              class="rounded-lg border border-night-owl-border bg-night-owl-bg/80 px-3 py-2 text-night-owl-fg focus:border-primary transition-colors outline-none"
            />
          </div>

          <button
            type="submit"
            class="mt-4 cursor-pointer bg-gradient-to-r from-primary to-accent font-semibold shadow-lg transition-all hover:opacity-90 active:scale-95 disabled:cursor-not-allowed disabled:opacity-50 px-4 py-2 rounded-lg text-on-primary"
          >
            {forms.SIGN_IN}
          </button>
        </div>
      </form>
    </div>
  </div>
</BaseLayout>
