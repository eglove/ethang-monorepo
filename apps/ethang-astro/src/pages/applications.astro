---
import { actions } from "astro:actions";
import { env } from "cloudflare:workers";
import isNil from "lodash/isNil.js";
import isObject from "lodash/isObject.js";

import {
    APPLICATION_STATUSES,
    applicationDatePagination,
    applicationsLoginRedirect,
    applicationsPagePath,
    formatApplicationDate,
    formatApplicationValue,
    isSafeApplicationUrl,
    parseApplicationDateParam,
} from "../lib/applications.ts";
import { decodeSessionCookie } from "../lib/session.ts";
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/ui/Button.astro";
import Heading from "../components/ui/Heading.astro";
import Page from "../components/ui/Page.astro";
import Pagination from "../components/ui/Pagination.astro";

export const prerender = false;

type Application = {
    applicationUrl: null | string;
    appliedDate: null | string;
    company: string;
    id: string;
    location: null | string;
    nextInterviewDate: null | string;
    resumeFilename: null | string;
    salary: null | string;
    status: (typeof APPLICATION_STATUSES)[number];
    title: string;
};

type ListApplicationsValue = {
    items: Application[];
};

type ListApplicationsResult = {
    ok: boolean;
    value?: ListApplicationsValue;
};

const isSuccessfulListResult = (
    result: unknown,
): result is ListApplicationsResult & { value: ListApplicationsValue } => {
    if (!isObject(result) || result.ok !== true || !isObject(result.value)) {
        return false;
    }

    return Array.isArray(result.value.items);
};

const session = decodeSessionCookie(Astro.cookies.get("session")?.value);

if (isNil(session)) {
    return Astro.redirect(applicationsLoginRedirect());
}

const selectedDate = parseApplicationDateParam(
    Astro.url.searchParams.get("date"),
);
const actionResult = Astro.getActionResult(actions.updateApplicationStatus);
const actionData = actionResult?.data;
if (isObject(actionData) && actionData.success === true) {
    return Astro.redirect(applicationsPagePath(selectedDate));
}
const actionError = actionResult?.error?.message;
const actionPath = isNil(selectedDate)
    ? actions.updateApplicationStatus
    : `${actions.updateApplicationStatus}&date=${encodeURIComponent(selectedDate)}`;

const isSuccessfulDatesResult = (
    result: unknown,
): result is { ok: true; value: string[] } => {
    return (
        isObject(result) && result.ok === true && Array.isArray(result.value)
    );
};

const datesResult = await env.job_applications
    .listAppliedDates({ token: session.sessionToken })
    .catch(() => {
        return null;
    });
const datesFailed = !isSuccessfulDatesResult(datesResult);
const appliedDates = datesFailed ? [] : datesResult.value;

const activeDate = selectedDate ?? appliedDates[0] ?? null;
const listOutcome =
    isNil(activeDate) ?
        ({ ok: true as const, value: { items: [] } } as const)
    :   await env.job_applications
            .listApplications({
                appliedDate: activeDate,
                status: null,
                token: session.sessionToken,
            })
            .catch(() => {
                return null;
            });
const listFailed = !isSuccessfulListResult(listOutcome);
const hasLoadError = datesFailed || listFailed;
const items = listFailed ? [] : listOutcome.value.items;
const pagination = applicationDatePagination(appliedDates, activeDate);

const isUnauthorizedResult = (result: unknown) => {
    return (
        isObject(result) &&
        "ok" in result &&
        result.ok === false &&
        "error" in result &&
        isObject(result.error) &&
        "code" in result.error &&
        result.error.code === "UNAUTHENTICATED"
    );
};

if (isUnauthorizedResult(datesResult) || isUnauthorizedResult(listOutcome)) {
    return Astro.redirect(
        `/login?redirect=${encodeURIComponent(`${Astro.url.pathname}${Astro.url.search}`)}`,
    );
}
---

<BaseLayout title="Applications">
    <Page class="w-full">
        <div class="flex w-full flex-col gap-5">
            <div>
                <p class="section-kicker mb-2">private application tracker</p>
                <Heading as="h1" class="text-3xl">Applications</Heading>
                <div class="section-rule mt-4"></div>
            </div>

            {
                actionError ? (
                    <div class="surface-card border border-danger/60 bg-danger/10 p-5">
                        <p class="text-sm font-medium text-danger">
                            {actionError}
                        </p>
                    </div>
                ) : null
            }

            {
                hasLoadError ? (
                    <div class="surface-card border border-danger/60 bg-danger/10 p-5">
                        <p class="text-sm font-medium text-danger">
                            Unable to load applications.
                        </p>
                    </div>
                ) : 0 === items.length ? (
                    <div class="surface-card border border-night-owl-border bg-night-owl-surface/80 p-5">
                        <p class="text-sm text-night-owl-muted">
                            No applications found.
                        </p>
                    </div>
                ) : (
                    <div class="surface-card overflow-x-auto border border-night-owl-border bg-night-owl-surface/80">
                        <table class="w-full min-w-[900px] text-left text-sm">
                            <thead class="border-b border-night-owl-border text-xs uppercase tracking-wide text-night-owl-muted">
                                <tr>
                                    <th class="px-4 py-3">Company</th>
                                    <th class="px-4 py-3">Title</th>
                                    <th class="px-4 py-3">Applied date</th>
                                    <th class="px-4 py-3">Resume</th>
                                    <th class="px-4 py-3">Salary</th>
                                    <th class="px-4 py-3">Next interview</th>
                                    <th class="px-4 py-3">Status</th>
                                    <th class="px-4 py-3">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-night-owl-border">
                                {items.map((application) => (
                                    <tr>
                                        <td class="px-4 py-4 font-medium text-night-owl-fg">
                                            {formatApplicationValue(
                                                application.company,
                                            )}
                                        </td>
                                        <td class="px-4 py-4 text-night-owl-fg">
                                            {formatApplicationValue(
                                                application.title,
                                            )}
                                        </td>
                                        <td class="px-4 py-4 text-night-owl-muted">
                                            {formatApplicationDate(
                                                application.appliedDate,
                                            )}
                                        </td>
                                        <td class="px-4 py-4 text-night-owl-muted">
                                            {application.resumeFilename ? (
                                                <a
                                                    href={`/applications/${application.id}/resume`}
                                                    target="_blank"
                                                    rel="noopener noreferrer"
                                                    class="text-primary hover:text-primary/80"
                                                >
                                                    {application.resumeFilename}
                                                </a>
                                            ) : (
                                                "—"
                                            )}
                                        </td>
                                        <td class="px-4 py-4 text-night-owl-muted">
                                            {formatApplicationValue(
                                                application.salary,
                                            )}
                                        </td>
                                        <td class="px-4 py-4 text-night-owl-muted">
                                            {formatApplicationDate(
                                                application.nextInterviewDate,
                                            )}
                                        </td>
                                        <td class="px-4 py-4">
                                            <form
                                                method="POST"
                                                action={actionPath}
                                                class="flex items-center gap-2"
                                            >
                                                <input
                                                    type="hidden"
                                                    name="id"
                                                    value={application.id}
                                                />
                                                <input
                                                    type="hidden"
                                                    name="date"
                                                    value={activeDate ?? ""}
                                                />
                                                <select
                                                    name="status"
                                                    class="rounded border border-night-owl-border bg-night-owl-surface px-2 py-1 text-sm text-night-owl-fg"
                                                >
                                                    {APPLICATION_STATUSES.map(
                                                        (status) => (
                                                            <option
                                                                value={status}
                                                                selected={
                                                                    application.status ===
                                                                    status
                                                                }
                                                            >
                                                                {status}
                                                            </option>
                                                        ),
                                                    )}
                                                </select>
                                                <Button
                                                    type="submit"
                                                    variant="outline"
                                                    size="xs"
                                                >
                                                    Save
                                                </Button>
                                            </form>
                                        </td>
                                        <td class="px-4 py-4">
                                            <div class="flex flex-col items-start gap-1">
                                                {isSafeApplicationUrl(
                                                    application.applicationUrl,
                                                ) ? (
                                                    <a
                                                        href={
                                                            application.applicationUrl
                                                        }
                                                        target="_blank"
                                                        rel="noopener noreferrer"
                                                        class="text-primary hover:text-primary/80"
                                                    >
                                                        View application
                                                    </a>
                                                ) : null}
                                                {!isSafeApplicationUrl(
                                                    application.applicationUrl,
                                                ) ? (
                                                    <span class="text-night-owl-muted">
                                                        —
                                                    </span>
                                                ) : null}
                                            </div>
                                        </td>
                                    </tr>
                                ))}
                            </tbody>
                        </table>
                    </div>
                )
            }

            <Pagination
                ariaLabel="Applications pagination"
                currentIndex={pagination.currentIndex}
                entries={pagination.entries}
            />
        </div>
    </Page>
</BaseLayout>
