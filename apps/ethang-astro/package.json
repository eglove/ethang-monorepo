{
  "browserslist": [
    "extends browserslist-config-baseline",
    "current node"
  ],
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.3",
    "@astrojs/mdx": "^7.0.7",
    "@astrojs/sitemap": "^3.7.3",
    "@cloudflare/vite-plugin": "^1.53.1",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.4",
    "effect": "^3.22.1",
    "lucide-astro": "^0.556.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "browserslist-config-baseline": "^0.5.0",
    "sharp": "0.35.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  },
  "engines": {
    "node": ">=24"
  },
  "name": "ethang-astro",
  "scripts": {
    "astro": "astro",
    "build": "astro build",
    "cf-typegen": "wrangler types --config wrangler.jsonc --config ../ethang-courses/wrangler.jsonc --config ../ethang-rss/wrangler.jsonc --config ../job-applications/wrangler.jsonc && pnpm emit-rpc-declarations && pnpm rewrite-rpc-imports",
    "deploy": "astro build && wrangler deploy",
    "dev": "astro dev",
    "emit-rpc-declarations": "node scripts/emit-rpc-declarations.ts",
    "generate-types": "wrangler types",
    "lint": "eslint . --fix && pnpm tsc --noEmit",
    "preview": "astro build && astro preview",
    "rewrite-rpc-imports": "node scripts/rewrite-rpc-imports.ts",
    "test": "pnpm test:vitest",
    "test:vitest": "vitest run --coverage"
  },
  "type": "module",
  "version": "0.0.1"
}
