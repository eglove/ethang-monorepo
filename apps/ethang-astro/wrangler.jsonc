{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "main": "@astrojs/cloudflare/entrypoints/server",
  "name": "ethang-astro",
  "r2_buckets": [
    {
      "binding": "jobResumes",
      "bucket_name": "job-resumes",
      "preview_bucket_name": "job-resumes-preview"
    }
  ],
  "observability": {
    "enabled": true
  },
  "placement": {
    "mode": "smart"
  },
  "routes": [
    {
      "custom_domain": true,
      "pattern": "ethang.dev"
    },
    {
      "custom_domain": true,
      "pattern": "www.ethang.dev"
    }
  ],
  "services": [
    {
      "binding": "ethang_courses",
      "remote": true,
      "service": "ethang-courses"
    },
    {
      "binding": "ethang_rss",
      "remote": true,
      "service": "ethang-rss"
    },
    {
      "binding": "job_applications",
      "remote": true,
      "service": "job-applications"
    }
  ]
}
