{
  "name": "logger-service",
  "version": "1.0.0",
  "type": "module",
  "author": "Ethan Glover",
  "license": "ISC",
  "scripts": {
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "deploy": "pnpm run cf-typegen && wrangler deploy --minify",
    "dev": "wrangler dev",
    "drizzle:generate": "drizzle-kit generate",
    "lint": "eslint src --fix && pnpm tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@ethang/schemas": "workspace:*",
    "@ethang/toolbelt": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "effect": "^3.21.4",
    "hono": "^4.12.28",
    "lodash": "^4.18.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260708.1",
    "@ethang/eslint-config": "workspace:*",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/lodash": "^4.17.24",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "browserslist-config-baseline": "^0.5.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.6.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.108.0"
  },
  "browserslist": [
    "extends browserslist-config-baseline",
    "current node"
  ],
  "engines": {
    "node": ">=24"
  }
}
